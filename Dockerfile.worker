FROM python:3.10-slim

# 1. Переменные среды
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# 2. Установка зависимостей и Tesseract
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    libffi-dev \
    libpq-dev \
    tesseract-ocr \
    texlive-xetex \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-lang-cyrillic \
    fonts-freefont-ttf \
    fonts-dejavu \
    lmodern \
 && rm -rf /var/lib/apt/lists/*

# 3. Папка проекта
WORKDIR /app

# 4. Установка Python-зависимостей
COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel \
 && pip install --no-cache-dir -r requirements.txt

# 5. Копирование исходников
COPY . .

# 6. Выполнение миграции + запуск воркера
CMD ["sh", "-c", "python3 scripts/migrate_telegram_hash.py && python3 -u -m worker.main"]
