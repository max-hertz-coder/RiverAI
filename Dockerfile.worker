# Dockerfile.worker
# Базовый образ Python 3.10
FROM python:3.10-slim

# 1) Системные зависимости для сборки C-расширений и LaTeX
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       python3-dev \
       libffi-dev \
       libpq-dev \
       texlive-latex-base \
    && rm -rf /var/lib/apt/lists/*

# 2) Рабочая директория внутри контейнера
WORKDIR /app

# 3) Копируем файл зависимостей и устанавливаем Python-пакеты
COPY requirements.txt ./
RUN pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir pymupdf

# 4) Копируем весь код приложения (bot_app/, worker/, и др.)
COPY . .

# 5) Настройка окружения
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# 6) Точка входа: запускаем воркера
CMD ["python", "-u", "-m", "worker.main"]
