# Воркер (GPT / OCR / LaTeX PDF)
FROM python:3.10-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Системные зависимости:
# - build deps для asyncpg/cryptography
# - TeX Live (pdflatex/xelatex + кириллица) для компиляции .tex → PDF
# - tesseract-ocr (если нужен локальный OCR)
# - базовые шрифты
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential python3-dev libffi-dev libpq-dev libssl-dev \
      tesseract-ocr \
      texlive-latex-base texlive-xetex texlive-latex-recommended texlive-latex-extra \
      texlive-fonts-recommended texlive-lang-cyrillic \
      fonts-dejavu fonts-freefont-ttf lmodern \
      ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Зависимости — отдельным слоем
COPY requirements.txt pyproject.toml ./
RUN pip install --upgrade pip setuptools wheel \
 && pip install --no-cache-dir -r requirements.txt

# Исходники
COPY . .

# Непривилегированный пользователь
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# HEALTHCHECK: проверяем доступность RabbitMQ
HEALTHCHECK --interval=30s --timeout=5s --retries=10 \
  CMD python -c "import os,socket,sys; s=socket.socket(); s.settimeout(3); \
host=os.getenv('RABBITMQ_HOST','rabbitmq'); port=int(os.getenv('RABBITMQ_PORT','5672')); \
import errno; \
try: s.connect((host,port)); rc=0 \
except Exception: rc=1 \
finally: s.close(); sys.exit(rc)"

# Запуск воркера
CMD ["python", "-u", "-m", "worker.main"]
