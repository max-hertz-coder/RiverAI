# Dockerfile.worker

# 1. Базовый образ
FROM python:3.10-slim

# 2. Отключаем интерактивные подсказки APT
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# 3. Устанавливаем системные зависимости, Tesseract и полный LaTeX со шрифтами для кириллицы
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    libffi-dev \
    libpq-dev \
    tesseract-ocr \
    texlive-xetex \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-lang-cyrillic \
    fonts-freefont-ttf \
    fonts-dejavu \
    lmodern \
 && rm -rf /var/lib/apt/lists/*

# 4. Рабочая директория
WORKDIR /app

# 5. Копируем и устанавливаем Python-зависимости
COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel \
 && pip install --no-cache-dir -r requirements.txt

# 6. Копируем весь код
COPY . .

# 7. Точка входа — запускаем воркер
CMD ["python", "-u", "-m", "worker.main"]