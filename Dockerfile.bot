# Telegram-бот + aiohttp вебхук (порт 8080)
FROM python:3.10-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Системные зависимости:
# - build deps для asyncpg/cryptography
# - netcat для HEALTHCHECK порта
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential python3-dev libffi-dev libpq-dev libssl-dev \
      ca-certificates curl git netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Устанавливаем зависимости отдельным слоем
COPY requirements.txt pyproject.toml ./
RUN pip install --upgrade pip setuptools wheel \
 && pip install --no-cache-dir -r requirements.txt

# Копируем исходники
COPY . .

# Непривилегированный пользователь
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Вебхук оплаты слушает 8080 (aiohttp)
EXPOSE 8080

# HEALTHCHECK: TCP-порт вебхука доступен
HEALTHCHECK --interval=30s --timeout=5s --retries=10 \
  CMD sh -c 'nc -z 127.0.0.1 "${PAYMENT_WEBHOOK_PORT:-8080}"'

# Запуск бота:
# 1) пробуем модуль bot_app.main
# 2) если в проекте остался корневой main.py — используем его
CMD ["sh", "-c", "python -u -m bot_app.main || python -u main.py"]
